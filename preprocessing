from pathlib import Path
import geopandas as gpd
import pandas as pd

poi_dir = Path("Data/POI/South_West_England")

poi_files = sorted(poi_dir.rglob("*.gpkg"))

print(f"Found {len(poi_files)} GeoPackage files")
#%%
# Check CRS of each POI files

for file in poi_files:
    gdf = gpd.read_file(file, engine="pyogrio")
    print(file.name, gdf.crs)
#%%
# Combine all POIs

poi_merge = []

for file in poi_files:
    gdf = gpd.read_file(file, engine="pyogrio")

    # Keep the source file information
    gdf["source_file"] = file.name
    gdf["source_folder"] = file.parent.name

    poi_merge.append(gdf)

poi_all = gpd.GeoDataFrame(
    pd.concat(poi_merge, ignore_index=True),
    geometry="geometry",
    crs=poi_merge[0].crs
)

print(poi_all.shape)
poi_all.head()

#%%
# Check Duplicates
#%%
print("Duplicate ref_no:",
      poi_all["ref_no"].duplicated().sum())
#%%
poi_all[
    poi_all.duplicated(subset=["ref_no"], keep=False)
].sort_values("ref_no")
#%%
# Drop Duplicates
#%%
poi_all_clean = poi_all.drop_duplicates(subset=["ref_no"],
    keep="first"
).reset_index(drop=True)
#%%
poi_all_clean
#%%
poi_all_clean[
    poi_all_clean.duplicated(subset=["ref_no"], keep=False)
].sort_values("ref_no")
#%%
# Checking for empty geometries
#%%
poi_all_clean[poi_all_clean['geometry'].is_empty == True]
#%%
# Save merged crime data
#%%
poi_merged_path = Path("Data/POI/South_West_England/poi_merged.gpkg")

poi_all_clean.to_file(poi_merged_path, driver = "GPKG")
